# CognoDB connection — copy this file to `.env.local` and fill in your values.
# These values are read ONLY from the environment and are never committed.
# Get them from https://console.cognodb.com after provisioning a free c0 instance.

# Bolt URI, e.g. bolt+s://xxxx.databases.cognodb.cloud
COGNODB_URI=

# CognoDB username (shown once at provisioning; default is "cognodb")
COGNODB_USER=cognodb

# CognoDB password (shown only once — store it securely)
COGNODB_PASSWORD=
